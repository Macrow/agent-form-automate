# OpenAI-compatible model gateway
OPENAI_COMPATIBLE_BASE_URL=http://localhost:3902/v1
OPENAI_COMPATIBLE_API_KEY=replace-me
OPENAI_COMPATIBLE_MODEL=model-name

# Development permits *; production requires the exact frontend origin
FRONTEND_ORIGIN=*

# Conversation memory
OBSERVATIONAL_MEMORY_ENABLED=true
MESSAGE_HISTORY_MAX_TOKENS=8000

# Application timezone
TZ=Asia/Shanghai

# Storage backend: libsql (default) or postgres
STORAGE_TYPE=libsql
LIBSQL_URL=file:./mastra.db
# LIBSQL_AUTH_TOKEN=replace-me

# PostgreSQL settings (used when STORAGE_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/mastra
# DATABASE_SSL=false
